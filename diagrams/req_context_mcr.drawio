<mxfile host="app.diagrams.net" agent="architect-requirements" version="24.0.0">
  <diagram id="req-context-mcr" name="MCR Context Diagram">
    <mxGraphModel dx="1280" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="mcr" value="KV 캐시 최적 운용 런타임&#10;(MCR 1단계 — 시스템 경계)&#10;제공 기능: 워크로드 서빙 · KV 재사용 · 압축(pruning) · tier 배치 · KV 인지 스케줄링 · P/D 실행 · telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2A44;strokeColor=#0F1830;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="270" width="320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="LLM 응용 클라이언트&#10;RAG · multiturn · agent 서비스&#10;(1차 액터 — 기능을 요청)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="250" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="mem" value="메모리 tier&#10;HBM · host DRAM · NVMe SSD (상용, C-01)&#10;스펙은 파라미터(대역폭·용량·지연)로만 취급&#10;(2단계: 자사 디바이스가 같은 자리에 plug-in)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="310" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="운영자 (SRE)&#10;정책 설정 · 실험 구성 운용 (1차 액터)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="250" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="추론 요청 — 프롬프트·컨텍스트(RAG chunk 포함) · 세션/사용자 ID · SLO class" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="client" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="스트리밍 응답 — 첫 토큰(TTFT)~생성 토큰 (품질 bound 준수)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="KV 쓰기 — 배치·강등 · pruned/압축 저장 · 영속(세션/사용자)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="mem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="KV 읽기 — 재사용 로드 · 복원(승격)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mem" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="정책·구성 설정 — SLO·품질 예산 정책 · tier 구성 등록 · P/D 실험 구성" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="ops" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="KV telemetry · 리포트 — hit rate · 압축률 분포 · tier 점유 · 벤치 결과" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note" value="경계 외(비상호작용): retrieval 실행(외부 컴포넌트 — 결과 chunk는 클라이언트 요청의 컨텍스트로 유입) · LLM 모델(public 제공물 로드, 무수정 — C-02·03) · 근접연산·자사 디바이스 통합(2단계 이관) · 클러스터 규모 N 조정(고정 N 전제) · 모델 학습(R-22)&#10;근거: 요구사항 분석 v1.7 §3.1 시스템 경계 · §3.2 액터 — upstream framework(vLLM)는 소싱 의존(DP1)이라 제외" style="text;html=1;fontSize=10;fontColor=#6B7A90;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1160" height="44" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
