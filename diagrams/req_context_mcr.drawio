<mxfile host="app.diagrams.net" agent="architect-requirements" version="24.0.0">
  <diagram id="req-context-mcr" name="MCR Context Diagram">
    <mxGraphModel dx="1280" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="mcr" value="KV 캐시 최적 운용 런타임&#10;(MCR 1단계 — 시스템 경계)&#10;제공 기능: 워크로드 서빙 · KV 재사용 · 압축(pruning) · tier 배치 · KV 인지 스케줄링 · P/D 실행 · telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2A44;strokeColor=#0F1830;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="300" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="LLM 응용 클라이언트&#10;RAG · multiturn · agent 서비스&#10;(1차 액터 — 기능을 요청)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="ret" value="Retrieval 시스템 (Vector DB)&#10;유사도 검색 — 외부 컴포넌트 (FR-01)&#10;(검색 가속은 2단계)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="250" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="mem" value="메모리 tier&#10;HBM · host DRAM · NVMe SSD (상용, C-01)&#10;스펙은 파라미터(대역폭·용량·지연)로만 취급&#10;(2단계: 자사 디바이스가 같은 자리에 plug-in)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="360" width="240" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="운영자 (SRE)&#10;정책 설정 · 실험 구성 운용 (1차 액터)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="mdl" value="LLM 모델 리포지토리 (public)&#10;Transformer 계열 — KV cache 보유 (C-02)&#10;모델 개발·학습은 경계 외 (C-03·R-22)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#1F2A44;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="620" width="250" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="추론 요청 — 프롬프트·컨텍스트 · 세션/사용자 ID · SLO class" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="client" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="스트리밍 응답 — 첫 토큰(TTFT)~생성 토큰 (품질 bound 준수)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="유사도 검색 질의 (RAG 컨텍스트 조립용)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="ret"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="문서 chunk 반환 — chunk 목록 → KV 재사용 판정의 입력" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="ret" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="KV 쓰기 — 배치·강등 · pruned/압축 저장 · 영속(세션/사용자)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="mem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="KV 읽기 — 재사용 로드 · 복원(승격)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mem" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" value="정책·구성 설정 — SLO·품질 예산 정책 · tier 구성 등록 · P/D 실험 구성" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="ops" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" value="KV telemetry · 리포트 — hit rate · 압축률 분포 · tier 점유 · 벤치 결과" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mcr" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f9" value="모델 가중치·토크나이저 로드 — 무수정 사용, 재학습·구조 변경 없음 (C-03)" style="endArrow=classic;html=1;strokeColor=#555555;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="mdl" target="mcr"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note" value="경계 외(비상호작용): 근접연산 오프로드·자사 디바이스 통합(2단계 이관) · 클러스터 규모 N 조정(고정 N 테스트베드 전제) · 모델 학습(R-22)&#10;근거: 요구사항 분석 v1.7 §3.1 시스템 경계 · §3.2 액터 — upstream framework(vLLM)는 런타임 상호작용이 아닌 소싱 의존(DP1)이라 본 그림에서 제외" style="text;html=1;fontSize=10;fontColor=#6B7A90;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1160" height="44" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
