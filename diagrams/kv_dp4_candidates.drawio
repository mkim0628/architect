<mxfile host="app.diagrams.net">
  <diagram name="DP4 candidates" id="kv-dp4">
    <mxGraphModel dx="1420" dy="980" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="&lt;b&gt;DP4. 정확도를 유지한 KV 캐시 압축 — 후보구조 설계도&lt;/b&gt;&lt;br&gt;확정안 v2 패키지 구조(Memory Engine 중심) 위에서 pruning 집행 시점·자산 표현만 다름 — Memory Compressor는 양쪽 모두 mechanism 전담(v2)" style="text;html=1;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="46" as="geometry"/></mxCell>

        <mxCell id="h1" value="&lt;b&gt;후보구조 1 — 입장 시 고정 예산·단일 사본형 (eager, 파괴적)&lt;/b&gt;" style="fillColor=#DCE3EE;strokeColor=#44546A;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="620" height="30" as="geometry"/></mxCell>
        <mxCell id="c1eng" value="«MCR» Inference Engine" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="112" width="580" height="100" as="geometry"/></mxCell>
        <mxCell id="c1sec" value="&lt;b&gt;Step Execution Controller&lt;/b&gt;&lt;br&gt;prefill 완료 시점" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="84" y="146" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="c1me" value="«MCR» Memory Engine" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="250" width="580" height="360" as="geometry"/></mxCell>
        <mxCell id="c1e1" value="prefill 종료 KV (1회 통과)" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c1eng" target="c1me"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1cm" value="«package» Cache Manager" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="84" y="286" width="532" height="180" as="geometry"/></mxCell>
        <mxCell id="c1pr" value="&lt;b&gt;Prefill-exit Pruner (신설)&lt;/b&gt;&lt;br&gt;훅 1점 — 전역 예산(예: 토큰 20%)&lt;br&gt;중요도 판정·확정 집행, 재평가 없음" style="html=1;fillColor=#FDF6E9;strokeColor=#B45309;dashed=1;" vertex="1" parent="1"><mxGeometry x="104" y="318" width="256" height="76" as="geometry"/></mxCell>
        <mxCell id="c1mc" value="&lt;b&gt;Memory Compressor&lt;/b&gt;&lt;br&gt;mechanism 집행 전담" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="384" y="318" width="212" height="76" as="geometry"/></mxCell>
        <mxCell id="c1e2" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c1pr" target="c1mc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1ix" value="&lt;b&gt;KV Index — 단일 사본(pruned)만 지시&lt;/b&gt;&lt;br&gt;원본 없음 — 예산·알고리즘이 자산에 각인" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="104" y="406" width="492" height="50" as="geometry"/></mxCell>
        <mxCell id="c1tl" value="«package» Tier &amp; Lifecycle — Migration: 저장·강등·영속·재사용 로드 전부 pruned 사본 (전 경로 경량)&lt;br&gt;Tiered KV Store [ HBM | DRAM | SSD ] — 모든 tier에 pruned 사본만 존재&lt;br&gt;&lt;font color=&quot;#B3402A&quot;&gt;재사용 hit의 잔여물 = 과거 쿼리 기준 pruned KV — 미래 쿼리 회복 수단 없음&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="84" y="480" width="532" height="110" as="geometry"/></mxCell>
        <mxCell id="c1note" value="&lt;font color=&quot;#1B7A4B&quot;&gt;&lt;b&gt;이득: 산술 5× 용량 (QA4) · decode 읽기량 즉감 (QA1) · 구조 최소(훅 1·사본 1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B3402A&quot;&gt;&lt;b&gt;제약: 불가역 — ΔF1 bound 보장 실패 리스크 (QA2, pruning×재사용 충돌) · 기법 교체 시 전 자산 재생성 (QA5)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;보완 필수(채택 시): 재사용 태그 KV의 보수 예산 규칙 — 중재 주체는 DP2 채택안" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="580" height="90" as="geometry"/></mxCell>

        <mxCell id="h2" value="&lt;b&gt;후보구조 2 — 수명주기 적응·이중 표현형 (adaptive, 가역)&lt;/b&gt;" style="fillColor=#DCE3EE;strokeColor=#44546A;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="650" height="30" as="geometry"/></mxCell>
        <mxCell id="c2orch" value="«MCR» Inference Orchestration — SLO/QoS Monitor: 품질 telemetry·요청별 품질 예산 힌트 하향 (소재는 DP2)" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="112" width="610" height="60" as="geometry"/></mxCell>
        <mxCell id="c2me" value="«MCR» Memory Engine" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="206" width="610" height="420" as="geometry"/></mxCell>
        <mxCell id="c2fb" value="품질 피드백 루프 (FR-07)" style="html=1;strokeColor=#6B7A90;dashed=1;" edge="1" parent="1" source="c2orch" target="c2me"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2cm" value="«package» Cache Manager" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="754" y="242" width="562" height="160" as="geometry"/></mxCell>
        <mxCell id="c2lpm" value="&lt;b&gt;Lifecycle Pruning Manager (신설)&lt;/b&gt;&lt;br&gt;· 수명주기 훅 분산: 생성→영속→재사용→재평가&lt;br&gt;· 요청별 품질 예산 → view 예산 결정&lt;br&gt;· 품질 피드백(FR-07)으로 예산 재조정" style="html=1;fillColor=#FDF6E9;strokeColor=#B45309;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="774" y="274" width="280" height="96" as="geometry"/></mxCell>
        <mxCell id="c2mc" value="&lt;b&gt;Memory Compressor&lt;/b&gt;&lt;br&gt;mechanism 집행 전담" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="1074" y="274" width="242" height="96" as="geometry"/></mxCell>
        <mxCell id="c2e1" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c2lpm" target="c2mc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2ix" value="&lt;b&gt;KV Index — 이중 표현 (확장): 원본 ↔ 파생 pruned view&lt;/b&gt;&lt;br&gt;요청은 예산에 맞는 view로, 미래 쿼리·재사용은 원본에서 재파생 (가역)" style="html=1;fillColor=#FDF6E9;strokeColor=#B45309;dashed=1;" vertex="1" parent="1"><mxGeometry x="754" y="418" width="562" height="56" as="geometry"/></mxCell>
        <mxCell id="c2tl" value="«package» Tier &amp; Lifecycle" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="754" y="490" width="562" height="120" as="geometry"/></mxCell>
        <mxCell id="c2up" value="&lt;b&gt;상위 tier (HBM/DRAM)&lt;/b&gt;&lt;br&gt;파생 pruned view 상주 — decode 읽기량은 후보1과 동등" style="html=1;fillColor=#EAF1E7;strokeColor=#1B7A4B;" vertex="1" parent="1"><mxGeometry x="774" y="522" width="256" height="72" as="geometry"/></mxCell>
        <mxCell id="c2lo" value="&lt;b&gt;하위 tier (SSD)&lt;/b&gt;&lt;br&gt;원본 보존 — 파괴 대신 강등 (Migration이 강등 수행)" style="html=1;fillColor=#EDEFF4;strokeColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="1060" y="522" width="256" height="72" as="geometry"/></mxCell>
        <mxCell id="c2e2" value="파생" style="html=1;strokeColor=#B45309;dashed=1;" edge="1" parent="1" source="c2lo" target="c2up"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2note" value="&lt;font color=&quot;#1B7A4B&quot;&gt;&lt;b&gt;이득: 가역 — 요청별 ΔF1 bound 집행·충돌 구조 해소 (QA2) · 알고리즘 교체 = 파생 재생성만 (QA5)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B3402A&quot;&gt;&lt;b&gt;제약: 이중 사본의 하위 tier 잠식 + 원본–파생 정합성 관리 (QA4) · view 생성·재평가 연산의 피크 잠식 (QA1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DP3 커플링: 원본 보존이 선택 재계산의 품질 상한 보존 — 검토 노트: 재사용 태그만 이중 표현하는 hybrid 유력" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="730" y="640" width="610" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
