        <mxCell id="t1" value="&lt;b&gt;후보 1 — 입장 시 고정 예산·단일 사본형 (eager, 파괴적)&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="640" height="30" as="geometry"/></mxCell>
        <mxCell id="c1pr" value="&lt;b&gt;Prefill-exit Pruner (신설, 훅 1점)&lt;/b&gt; — 전역 예산(예: 토큰 20%)으로 확정 집행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBDD;strokeColor=#ED7D31;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="600" height="50" as="geometry"/></mxCell>
