<mxfile host="app.diagrams.net">
  <diagram name="DP3 candidates" id="kv-dp3">
    <mxGraphModel dx="1420" dy="980" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="&lt;b&gt;DP3. KV 재사용 범위·복원 전략 — 후보구조 설계도&lt;/b&gt;&lt;br&gt;확정안 v2 패키지 구조 위에서 재계산 토큰 선택 연산의 실행 위치·시점만 다름 — 주황: 신설 컴포넌트" style="text;html=1;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="46" as="geometry"/></mxCell>

        <mxCell id="h1" value="&lt;b&gt;후보구조 1 — 본체 융합형 (in-engine, exact)&lt;/b&gt;" style="fillColor=#DCE3EE;strokeColor=#44546A;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="620" height="30" as="geometry"/></mxCell>
        <mxCell id="c1orch" value="«MCR» Inference Orchestration" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="112" width="580" height="140" as="geometry"/></mxCell>
        <mxCell id="c1ret" value="&lt;b&gt;Retrieval Engine&lt;/b&gt;&lt;br&gt;chunk 목록 산출" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="84" y="150" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="c1rt" value="&lt;b&gt;KV-aware Router&lt;/b&gt;&lt;br&gt;KV Locator 조회 → 재사용 판정" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="366" y="150" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="c1e1" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c1ret" target="c1rt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1eng" value="«MCR» Inference Engine" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="290" width="580" height="290" as="geometry"/></mxCell>
        <mxCell id="c1sec" value="&lt;b&gt;Step Execution Controller&lt;/b&gt;&lt;br&gt;continuous batching" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="84" y="326" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="c1kl" value="«package» Kernel &amp; Layer" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="84" y="396" width="532" height="170" as="geometry"/></mxCell>
        <mxCell id="c1att" value="&lt;b&gt;Attention Engine&lt;/b&gt;&lt;br&gt;1층 전체 연산" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="104" y="428" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="c1fs" value="&lt;b&gt;Fused Selector (신설)&lt;/b&gt;&lt;br&gt;1층 연산과 융합 — 실제 K/V deviation·attention 스코어로 재계산 토큰 확정&lt;br&gt;2층~N층: 선택 토큰만 재계산 (로딩과 중첩)&lt;br&gt;&lt;font color=&quot;#B3402A&quot;&gt;훅 = 엔진 실행 루프(layer 경계) 내부 — 코어 훅&lt;/font&gt;" style="html=1;fillColor=#FDF6E9;strokeColor=#B45309;dashed=1;" vertex="1" parent="1"><mxGeometry x="352" y="424" width="244" height="120" as="geometry"/></mxCell>
        <mxCell id="c1e2" style="html=1;strokeColor=#B45309;dashed=1;" edge="1" parent="1" source="c1att" target="c1fs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1e3" value="«use» prefill 실행 (선택은 엔진 안에서)" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c1orch" target="c1eng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1me" value="«MCR» Memory Engine" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="616" width="580" height="120" as="geometry"/></mxCell>
        <mxCell id="c1ix" value="&lt;b&gt;KV Index (v2 신규)&lt;/b&gt;&lt;br&gt;비접두 chunk lookup · KV Locator" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="84" y="652" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="c1tr" value="&lt;b&gt;KV Transport&lt;/b&gt;&lt;br&gt;chunk KV 로딩 (재계산과 중첩)" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="366" y="652" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="c1e4" value="«use» chunk KV fetch" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c1me" target="c1eng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1note" value="&lt;font color=&quot;#1B7A4B&quot;&gt;&lt;b&gt;이득: 근사 오차 0 (QA2) · 문헌 실측 앵커 — TTFT 2.2–3.3× 직도달 (QA3)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B3402A&quot;&gt;&lt;b&gt;제약: 선택 연산이 피크 GPU 소비 (QA1) · 코어 훅 — 릴리스 추종·교체 시 코어 재검증 (QA5)&lt;/b&gt;&lt;br&gt;DP1 커플링: layer-경계 훅은 vLLM 확장점 밖 — 변형 B(LMCache 편승)는 사실상 봉쇄&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="580" height="80" as="geometry"/></mxCell>

        <mxCell id="h2" value="&lt;b&gt;후보구조 2 — 경량 선행형 (proxy, speculative)&lt;/b&gt;" style="fillColor=#DCE3EE;strokeColor=#44546A;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="650" height="30" as="geometry"/></mxCell>
        <mxCell id="c2orch" value="«MCR» Inference Orchestration" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="112" width="610" height="230" as="geometry"/></mxCell>
        <mxCell id="c2ret" value="&lt;b&gt;Retrieval Engine&lt;/b&gt;&lt;br&gt;반환 즉시 query+chunk 존재" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="754" y="150" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="c2px" value="&lt;b&gt;Proxy Selector (신설)&lt;/b&gt;&lt;br&gt;축소 모델/저차원 근사 attention&lt;br&gt;CPU·보조 스트림 — 엔진 밖 독립 컴포넌트" style="html=1;fillColor=#FDF6E9;strokeColor=#B45309;dashed=1;" vertex="1" parent="1"><mxGeometry x="1046" y="146" width="270" height="76" as="geometry"/></mxCell>
        <mxCell id="c2plan" value="&lt;b&gt;재계산·로딩 Plan — prefill 시작 전 확정&lt;/b&gt;&lt;br&gt;재계산 토큰 집합 + chunk 로딩 순서 + prefetch 지시" style="html=1;fillColor=#FDF6E9;strokeColor=#B45309;dashed=1;" vertex="1" parent="1"><mxGeometry x="754" y="256" width="562" height="56" as="geometry"/></mxCell>
        <mxCell id="c2e1" style="html=1;strokeColor=#B45309;dashed=1;" edge="1" parent="1" source="c2ret" target="c2px"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2e2" style="html=1;strokeColor=#B45309;dashed=1;" edge="1" parent="1" source="c2px" target="c2plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2eng" value="«MCR» Inference Engine — 무수정 (신설 컴포넌트 없음)&lt;br&gt;&lt;font color=&quot;#1B7A4B&quot;&gt;prefill = 로딩 ∥ 재계산 ∥ prefetch 파이프라인 극대&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="380" width="610" height="130" as="geometry"/></mxCell>
        <mxCell id="c2sec" value="Step Execution Controller" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="754" y="436" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="c2att" value="Attention Engine" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="1066" y="436" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="c2e3" value="Plan 전달 (엔진은 계획대로만 실행)" style="html=1;strokeColor=#1F2A44;" edge="1" parent="1" source="c2plan" target="c2eng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2me" value="«MCR» Memory Engine" style="rounded=0;html=1;fillColor=#F4F6FA;strokeColor=#44546A;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="730" y="536" width="610" height="120" as="geometry"/></mxCell>
        <mxCell id="c2ix" value="&lt;b&gt;KV Index (v2 신규)&lt;/b&gt;&lt;br&gt;Proxy가 chunk 메타데이터 참조" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="754" y="572" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="c2tr" value="&lt;b&gt;KV Transport&lt;/b&gt;&lt;br&gt;Plan 순서로 선행 prefetch" style="html=1;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="1066" y="572" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="c2e4" value="prefetch 지시" style="html=1;strokeColor=#1F2A44;dashed=1;" edge="1" parent="1" source="c2plan" target="c2tr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2note" value="&lt;font color=&quot;#1B7A4B&quot;&gt;&lt;b&gt;이득: 선택 연산이 GPU 임계 경로 밖 (QA1) · 엔진 무수정 — proxy 교체 = 알고리즘 교체 (QA5)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B3402A&quot;&gt;&lt;b&gt;제약: 근사 오차 — ΔF1 리스크 → 방어 시 재계산율 보수 상향 → TTFT 반납 (QA2↔QA3)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DP1 커플링: 전 채택안에서 성립 — 변형 B에서는 사실상 유일 후보" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="730" y="670" width="610" height="80" as="geometry"/></mxCell>

        <mxCell id="orth" value="&lt;b&gt;직교 축 (두 후보 공통 결합): SLO/품질 예산 기반 동적 재계산율 컨트롤러 — QA2 요청별 bound 집행 수단 (정책 소재는 DP2)&lt;/b&gt;&lt;br&gt;결정 변수: 경량 근사의 선택 일치율이 ΔF1 bound를 지킬 만큼 높은가 — 팀 알고리즘 연구가 실측으로 답할 질문" style="rounded=0;html=1;fillColor=#FBFCFE;strokeColor=#44546A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1320" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
